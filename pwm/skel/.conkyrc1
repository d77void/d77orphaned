-- d77orphaned: pwm's keybindings (pwm 0.6.8 defaults) and the state of the
-- machine. Started by /etc/d77orphaned/pwm-startup.sh. Read-only commands.
conky.config = {
    -- Left: the pwm wallpapers have the kitten and the kite on the right.
    alignment = 'bottom_left',
    background = true,
    default_color = 'white',
    double_buffer = true,
    draw_shades = false,
    font = 'Hack:size=8',
    gap_x = 40,
    gap_y = 40,
    minimum_width = 280,
    no_buffers = true,
    out_to_console = false,
    out_to_x = true,
    own_window = true,
    own_window_class = 'Conky',
    own_window_type = 'override',
    own_window_hints = 'undecorated,sticky,below,skip_taskbar,skip_pager',
    -- Dark, semi-transparent panel: readable on light and dark wallpapers.
    own_window_argb_visual = true,
    own_window_argb_value = 200,
    own_window_colour = '1e1e2e',
    border_inner_margin = 10,
    update_interval = 2.0,
    use_xft = true,
}

conky.text = [[
${font Hack:size=10}${color green}d77orphaned$color$font
${color grey}kernel   $color$kernel
${color grey}uptime   $color$uptime
${color grey}cpu      $color$cpu%   ${color grey}ram $color$mem / $memmax
${color grey}network  $color${execi 10 ip -br -4 addr | awk '$1 != "lo" && $3 != "" {printf "%s %s  ", $1, $3}'}
$hr
${color green}Disks$color (nothing is mounted automatically)
${execi 30 lsblk -dno NAME,SIZE,MODEL | grep -v '^loop' | head -n 8}
$hr
${color green}Keys$color
${color grey}super + return    $color terminal (st)
${color grey}super + d         $color dmenu
${color grey}super + j / k     $color focus next / previous
${color grey}super + shift + j/k$color move window
${color grey}super + m         $color next layout
${color grey}super + q         $color close window
${color grey}super + t         $color lock (password: voidlinux)
${color grey}super + 1..9      $color workspace
${color grey}super + x         $color log out / power
$hr
${color grey}help              $color d77-docs (works offline)
]]
